# Quadlet for the Workload Selector control app (runs on the RHEL tablet).
# Install to: /etc/containers/systemd/workload-selector.container
# Then: sudo systemctl daemon-reload && sudo systemctl start workload-selector
#
# EDIT the Environment lines for your booth. This file lives on the tablet
# only — it holds credentials, so it is NOT in git.
[Unit]
Description=Toughbook Workload Selector (Flask control app)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/workload-selector:latest
Network=host
Environment=TARGET_IPS=192.168.8.101,192.168.8.102
Environment=TARGET_SSH_USER=core
Environment=TARGET_SSH_PASS=edge
Environment=TARGET_BECOME_PASS=edge
Environment=REGISTRY_HOST=192.168.8.100:5000
Environment=IMAGE_REPO=bootc-flightgear
# Optional: limit/extend the mission buttons, e.g. add FlightGear tags if they work:
# Environment=WORKLOADS=cop,cuas,isr,netops,sustain,cop-degraded,home,f35
# Field Docs access key comes from the podman secret store (never the image or git).
# Create it once as root:  read -rs K && printf '%s' "$K" | sudo podman secret create okp_key - && unset K
Secret=okp_key,type=env,target=OKP_ACCESS_KEY
Environment=PORT=80

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target default.target
